// ==========================================
// 自动治愈花园 全局兼容与错误捕获 强制前置
// 存储路径：D:\AutoHealingGarden\src\game.js
// 禁止修改、禁止移动位置，必须放在文件最顶部
// ==========================================
!function(){
  if (typeof globalThis === 'undefined') return;
  // 兼容window全局对象
  if (typeof window === 'undefined') {
    globalThis.window = globalThis;
  }
  // 批量兼容H5常见全局对象
  const compatVars = ['self', 'global', 'top', 'parent', 'navigator', 'location', 'history', 'screen'];
  compatVars.forEach(function(key) {
    if (typeof globalThis[key] === 'undefined') {
      globalThis[key] = globalThis;
    }
  });
}();

// 全局错误捕获 防止游戏卡死
const errorCatchApi = typeof wx !== 'undefined' ? wx : tt;
errorCatchApi.onError(function(err) {
  console.error('游戏运行错误（已自动捕获）:', err);
  return true;
});

// 引入双平台统一适配层
require('../platform/index.js');

// ==========================================
// 下方仅可编写花园主题业务代码
// ==========================================

// 自动治愈花园核心业务代码
// 版本：v1.0
// 创建时间：2026-04-09
// 作者：自动治愈花园开发团队

console.log('自动治愈花园加载成功！平台环境：', Platform.env);

// 游戏配置对象
const GameConfig = {
  // 花园配置
  garden: {
    maxPlots: 24, // 最大花田数量
    initialPlots: 6, // 初始花田数量
    plotRows: 4, // 花田行数
    plotCols: 6, // 花田列数
    plotSize: 100, // 花田尺寸
    plotSpacing: 20, // 花田间距
  },
  
  // 花卉配置
  flowers: {
    // 普通花卉
    sunflower: {
      name: '向日葵',
      growthTime: 600, // 10分钟
      reward: 10,
      price: 5
    },
    tulip: {
      name: '郁金香',
      growthTime: 1200, // 20分钟
      reward: 20,
      price: 10
    },
    rose: {
      name: '玫瑰',
      growthTime: 3600, // 1小时
      reward: 50,
      price: 25
    },
    // 稀有花卉
    sakura: {
      name: '樱花',
      growthTime: 7200, // 2小时
      reward: 100,
      price: 50,
      unlockLevel: 5
    },
    lavender: {
      name: '薰衣草',
      growthTime: 21600, // 6小时
      reward: 300,
      price: 150,
      unlockLevel: 10
    },
    clover: {
      name: '四叶草',
      growthTime: 43200, // 12小时
      reward: 600,
      price: 300,
      unlockLevel: 15
    }
  },
  
  // 游戏状态
  gameState: {
    level: 1,
    coins: 100, // 初始花币
    exp: 0,
    unlockedPlots: 6,
    flowers: {},
    gardenDecoration: {},
    lastSaveTime: Date.now()
  }
};

// 游戏主对象
const AutoHealingGarden = {
  // 初始化游戏
  init() {
    console.log('初始化自动治愈花园...');
    
    // 创建Canvas画布
    this.createCanvas();
    
    // 初始化花田系统
    this.initPlots();
    
    // 初始化UI
    this.initUI();
    
    // 加载游戏状态（必须在UI初始化之后）
    this.loadGameState();
    
    // 开始游戏循环
    this.startGameLoop();
    
    console.log('游戏初始化完成！');
  },
  
  // 创建Canvas画布
  createCanvas() {
    try {
      if (typeof wx !== 'undefined' && wx.createCanvas) {
        this.canvas = wx.createCanvas();
        this.ctx = this.canvas.getContext('2d');
        console.log('微信环境Canvas创建成功');
      } else if (typeof tt !== 'undefined' && tt.createCanvas) {
        this.canvas = tt.createCanvas();
        this.ctx = this.canvas.getContext('2d');
        console.log('抖音环境Canvas创建成功');
      } else {
        console.error('无法创建Canvas，使用默认尺寸继续运行');
        // 设置默认屏幕尺寸，让游戏可以继续运行（UI会使用默认值）
        this.screenWidth = 750;
        this.screenHeight = 1334;
        return;
      }
      
      // 设置Canvas尺寸（竖屏适配）
      this.canvas.width = 750;
      this.canvas.height = 1334;
      
      // 存储屏幕尺寸用于适配
      this.screenWidth = this.canvas.width;
      this.screenHeight = this.canvas.height;
      
      console.log('Canvas尺寸设置：', this.screenWidth, 'x', this.screenHeight);
    } catch (error) {
      console.error('Canvas创建异常，使用默认尺寸：', error);
      // 设置默认值，让游戏可以继续运行
      this.screenWidth = 750;
      this.screenHeight = 1334;
    }
  },
  
  // ==================== 花卉动画系统 ====================
  
  // 生长阶段定义
  GROWTH_STAGES: {
    SEED: { name: '种子', progress: 0.0, color: '#8B4513' },
    SPROUT: { name: '发芽', progress: 0.2, color: '#228B22' },
    SEEDLING: { name: '幼苗', progress: 0.4, color: '#32CD32' },
    BUD: { name: '花蕾', progress: 0.6, color: '#FF69B4' },
    BLOOM: { name: '盛开', progress: 0.8, color: '#FFD700' }
  },
  
  // 根据生长进度获取当前阶段
  getGrowthStage(progress) {
    const stages = this.GROWTH_STAGES;
    if (progress < 0.2) return stages.SEED;
    if (progress < 0.4) return stages.SPROUT;
    if (progress < 0.6) return stages.SEEDLING;
    if (progress < 0.8) return stages.BUD;
    return stages.BLOOM;
  },
  
  // 绘制花卉生长动画
  drawFlowerGrowth(plot) {
    if (!plot.flower || plot.state === 'empty' || plot.state === 'withered') {
      return;
    }
    
    const ctx = this.ctx;
    const centerX = plot.x + plot.width / 2;
    const centerY = plot.y + plot.height / 2;
    const radius = plot.width / 3;
    
    // 获取当前生长阶段
    const stage = this.getGrowthStage(plot.growthProgress || 0);
    
    // 绘制生长阶段指示器
    ctx.save();
    
    // 根据阶段绘制不同的视觉效果
    switch (stage) {
      case this.GROWTH_STAGES.SEED:
        // 种子阶段：棕色小圆点
        ctx.fillStyle = stage.color;
        ctx.beginPath();
        ctx.arc(centerX, centerY, radius * 0.3, 0, Math.PI * 2);
        ctx.fill();
        break;
        
      case this.GROWTH_STAGES.SPROUT:
        // 发芽阶段：绿色小苗
        ctx.fillStyle = stage.color;
        ctx.beginPath();
        ctx.arc(centerX, centerY, radius * 0.4, 0, Math.PI * 2);
        ctx.fill();
        
        // 两片小叶子
        ctx.fillStyle = '#228B22';
        ctx.beginPath();
        ctx.ellipse(centerX - radius * 0.3, centerY - radius * 0.2, radius * 0.2, radius * 0.1, 0, 0, Math.PI * 2);
        ctx.fill();
        
        ctx.beginPath();
        ctx.ellipse(centerX + radius * 0.3, centerY - radius * 0.2, radius * 0.2, radius * 0.1, 0, 0, Math.PI * 2);
        ctx.fill();
        break;
        
      case this.GROWTH_STAGES.SEEDLING:
        // 幼苗阶段：绿色植株
        ctx.fillStyle = stage.color;
        ctx.beginPath();
        ctx.arc(centerX, centerY, radius * 0.5, 0, Math.PI * 2);
        ctx.fill();
        
        // 叶子
        ctx.fillStyle = '#32CD32';
        for (let i = 0; i < 4; i++) {
          const angle = (i * Math.PI) / 2;
          const leafX = centerX + Math.cos(angle) * radius * 0.4;
          const leafY = centerY + Math.sin(angle) * radius * 0.4;
          ctx.beginPath();
          ctx.ellipse(leafX, leafY, radius * 0.25, radius * 0.15, angle, 0, Math.PI * 2);
          ctx.fill();
        }
        break;
        
      case this.GROWTH_STAGES.BUD:
        // 花蕾阶段：粉色花蕾
        ctx.fillStyle = stage.color;
        ctx.beginPath();
        ctx.arc(centerX, centerY, radius * 0.6, 0, Math.PI * 2);
        ctx.fill();
        
        // 花蕾细节
        ctx.fillStyle = '#FF1493';
        ctx.beginPath();
        ctx.arc(centerX, centerY, radius * 0.4, 0, Math.PI * 2);
        ctx.fill();
        break;
        
      case this.GROWTH_STAGES.BLOOM:
        // 盛开阶段：金色花朵
        ctx.fillStyle = stage.color;
        
        // 绘制花瓣
        const petalCount = 8;
        for (let i = 0; i < petalCount; i++) {
          const angle = (i * 2 * Math.PI) / petalCount;
          const petalX = centerX + Math.cos(angle) * radius * 0.7;
          const petalY = centerY + Math.sin(angle) * radius * 0.7;
          
          ctx.save();
          ctx.translate(petalX, petalY);
          ctx.rotate(angle);
          
          ctx.beginPath();
          ctx.ellipse(0, 0, radius * 0.4, radius * 0.2, 0, 0, Math.PI * 2);
          ctx.fill();
          
          ctx.restore();
        }
        
        // 花心
        ctx.fillStyle = '#FF4500';
        ctx.beginPath();
        ctx.arc(centerX, centerY, radius * 0.3, 0, Math.PI * 2);
        ctx.fill();
        break;
    }
    
    ctx.restore();
    
    // 绘制生长进度文本
    if (plot.state === 'growing') {
      ctx.fillStyle = '#4A5568';
      ctx.font = '20px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(
        `${stage.name} ${Math.round(plot.growthProgress * 100)}%`,
        centerX,
        plot.y + plot.height + 20
      );
    }
  },
  
  // 播放收获动画
  playHarvestAnimation(plot, reward) {
    // 简单版收获动画：显示奖励文本
    const ctx = this.ctx;
    const centerX = plot.x + plot.width / 2;
    const centerY = plot.y + plot.height / 2;
    
    ctx.save();
    ctx.fillStyle = '#D69E2E';
    ctx.font = 'bold 24px sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText(`+${reward}🌸`, centerX, centerY - 30);
    ctx.restore();
    
    console.log('播放收获动画：+', reward, '花币');
  },
  
  // ==================== 音效系统 ====================
  
  // 播放种植音效
  playPlantSound() {
    if (Platform && Platform.createAudio) {
      try {
        // 简化的音效实现
        console.log('播放种植音效');
      } catch (error) {
        console.error('播放音效失败:', error);
      }
    }
  },
  
  // 播放收获音效
  playHarvestSound() {
    if (Platform && Platform.createAudio) {
      try {
        console.log('播放收获音效');
      } catch (error) {
        console.error('播放音效失败:', error);
      }
    }
  },
  
  // 播放清理音效
  playClearSound() {
    if (Platform && Platform.createAudio) {
      try {
        console.log('播放清理音效');
      } catch (error) {
        console.error('播放音效失败:', error);
      }
    }
  },
  
  // 播放升级音效
  playLevelUpSound() {
    if (Platform && Platform.createAudio) {
      try {
        console.log('播放升级音效');
      } catch (error) {
        console.error('播放音效失败:', error);
      }
    }
  },
  
  // ==================== 花田系统 ====================
  
  // 初始化花田系统
  initPlots() {
    this.plots = [];
    const plotsPerRow = GameConfig.garden.plotCols;
    const plotsPerCol = GameConfig.garden.plotRows;
    const plotSize = GameConfig.garden.plotSize;
    const spacing = GameConfig.garden.plotSpacing;
    
    // 确保屏幕尺寸已定义（容错处理）
    const screenWidth = this.screenWidth || 750;
    const screenHeight = this.screenHeight || 1334;
    
    // 计算总宽度和起始位置
    const totalWidth = plotsPerRow * plotSize + (plotsPerRow - 1) * spacing;
    const startX = (screenWidth - totalWidth) / 2;
    const startY = screenHeight * 0.15; // 顶部信息层下方
    
    for (let row = 0; row < plotsPerCol; row++) {
      for (let col = 0; col < plotsPerRow; col++) {
        const plot = {
          id: row * plotsPerRow + col,
          x: startX + col * (plotSize + spacing),
          y: startY + row * (plotSize + spacing),
          width: plotSize,
          height: plotSize,
          isUnlocked: row * plotsPerRow + col < GameConfig.garden.initialPlots,
          state: 'empty', // empty, planting, growing, ready, withered
          flower: null,
          plantTime: 0,
          growthProgress: 0
        };
        this.plots.push(plot);
      }
    }
    
    console.log('花田系统初始化完成，共创建', this.plots.length, '块花田');
  },
  
  // 初始化UI
  initUI() {
    // 确保屏幕尺寸已定义（容错处理）
    const screenWidth = this.screenWidth || 750;
    const screenHeight = this.screenHeight || 1334;
    
    // 顶部信息层
    this.topBar = {
      x: 0,
      y: 0,
      width: screenWidth,
      height: screenHeight * 0.12,
      level: 1,
      coins: 100,
      exp: 0
    };
    
    // 底部功能层
    this.bottomBar = {
      x: 0,
      y: screenHeight * 0.82,
      width: screenWidth,
      height: screenHeight * 0.18,
      buttons: [
        { id: 'seeds', x: 0, y: 0, width: screenWidth / 5, height: screenHeight * 0.18, label: '种子' },
        { id: 'collection', x: screenWidth / 5, y: 0, width: screenWidth / 5, height: screenHeight * 0.18, label: '图鉴' },
        { id: 'decorate', x: 2 * screenWidth / 5, y: 0, width: screenWidth / 5, height: screenHeight * 0.18, label: '装扮' },
        { id: 'backpack', x: 3 * screenWidth / 5, y: 0, width: screenWidth / 5, height: screenHeight * 0.18, label: '背包' },
        { id: 'friends', x: 4 * screenWidth / 5, y: 0, width: screenWidth / 5, height: screenHeight * 0.18, label: '好友' }
      ]
    };
    
    console.log('UI初始化完成，屏幕尺寸：', screenWidth, 'x', screenHeight);
  },
  
  // 开始游戏循环
  startGameLoop() {
    const gameLoop = () => {
      this.update();
      this.render();
      requestAnimationFrame(gameLoop);
    };
    gameLoop();
  },
  
  // 更新游戏状态
  update() {
    const currentTime = Date.now();
    
    // 更新花田生长状态
    this.plots.forEach(plot => {
      if (plot.state === 'growing' && plot.flower && plot.plantTime > 0) {
        const elapsed = (currentTime - plot.plantTime) / 1000; // 秒
        const flowerConfig = GameConfig.flowers[plot.flower];
        if (flowerConfig) {
          const growthTime = flowerConfig.growthTime;
          plot.growthProgress = Math.min(elapsed / growthTime, 1);
          
          if (plot.growthProgress >= 1) {
            plot.state = 'ready';
            console.log('花田', plot.id, '的花卉已成熟！');
          }
        }
      }
    });
    
    // 定期保存游戏状态
    if (currentTime - GameConfig.gameState.lastSaveTime > 30000) { // 每30秒保存一次
      this.saveGameState();
      GameConfig.gameState.lastSaveTime = currentTime;
    }
  },
  
  // 渲染游戏画面
  render() {
    // 清空画布
    this.ctx.fillStyle = '#F5F7FA';
    this.ctx.fillRect(0, 0, this.screenWidth, this.screenHeight);
    
    // 渲染顶部信息层
    this.renderTopBar();
    
    // 渲染花田
    this.renderPlots();
    
    // 渲染底部功能层
    this.renderBottomBar();
  },
  
  // 渲染顶部信息层
  renderTopBar() {
    const bar = this.topBar;
    
    // 绘制背景
    this.ctx.fillStyle = 'rgba(255, 255, 255, 0.9)';
    this.ctx.fillRect(bar.x, bar.y, bar.width, bar.height);
    
    // 绘制等级
    this.ctx.fillStyle = '#4A5568';
    this.ctx.font = '28px sans-serif';
    this.ctx.textAlign = 'left';
    this.ctx.fillText('Lv.' + bar.level, 20, bar.y + 35);
    
    // 绘制花币
    this.ctx.fillStyle = '#D69E2E';
    this.ctx.textAlign = 'center';
    this.ctx.fillText('🌸 ' + bar.coins, bar.width / 2, bar.y + 35);
    
    // 绘制经验条
    const expBarWidth = 200;
    const expBarHeight = 20;
    const expBarX = bar.width - expBarWidth - 20;
    const expBarY = bar.y + (bar.height - expBarHeight) / 2;
    
    // 经验条背景
    this.ctx.fillStyle = '#E2E8F0';
    this.ctx.fillRect(expBarX, expBarY, expBarWidth, expBarHeight);
    
    // 经验条进度
    const expProgress = bar.exp / 100; // 假设100经验升一级
    this.ctx.fillStyle = '#4299E1';
    this.ctx.fillRect(expBarX, expBarY, expBarWidth * Math.min(expProgress, 1), expBarHeight);
    
    // 经验条边框
    this.ctx.strokeStyle = '#CBD5E0';
    this.ctx.lineWidth = 2;
    this.ctx.strokeRect(expBarX, expBarY, expBarWidth, expBarHeight);
  },
  
  // 渲染花田
  renderPlots() {
    this.plots.forEach(plot => {
      if (!plot.isUnlocked) {
        // 未解锁的花田
        this.ctx.fillStyle = '#E2E8F0';
        this.ctx.fillRect(plot.x, plot.y, plot.width, plot.height);
        
        this.ctx.fillStyle = '#A0AEC0';
        this.ctx.font = '24px sans-serif';
        this.ctx.textAlign = 'center';
        this.ctx.fillText('🔒', plot.x + plot.width / 2, plot.y + plot.height / 2);
        return;
      }
      
      // 根据花田状态绘制
      switch (plot.state) {
        case 'empty':
          this.ctx.fillStyle = '#C6F6D5'; // 可种植的浅绿色
          this.ctx.fillRect(plot.x, plot.y, plot.width, plot.height);
          
          this.ctx.fillStyle = '#38A169';
          this.ctx.font = '24px sans-serif';
          this.ctx.textAlign = 'center';
          this.ctx.fillText('可种花', plot.x + plot.width / 2, plot.y + plot.height / 2);
          break;
          
        case 'growing':
          this.ctx.fillStyle = '#FEFCBF'; // 生长中的浅黄色
          this.ctx.fillRect(plot.x, plot.y, plot.width, plot.height);
          
          // 绘制生长进度条
          const progressWidth = plot.width * 0.8;
          const progressHeight = 10;
          const progressX = plot.x + (plot.width - progressWidth) / 2;
          const progressY = plot.y + plot.height - 20;
          
          this.ctx.fillStyle = '#E2E8F0';
          this.ctx.fillRect(progressX, progressY, progressWidth, progressHeight);
          
          this.ctx.fillStyle = '#48BB78';
          this.ctx.fillRect(progressX, progressY, progressWidth * plot.growthProgress, progressHeight);
          
          // 显示剩余时间
          if (plot.flower) {
            const flowerConfig = GameConfig.flowers[plot.flower];
            if (flowerConfig) {
              const remainingTime = Math.max(0, flowerConfig.growthTime * (1 - plot.growthProgress));
              const minutes = Math.ceil(remainingTime / 60);
              this.ctx.fillStyle = '#4A5568';
              this.ctx.font = '20px sans-serif';
              this.ctx.fillText(`${minutes}分`, plot.x + plot.width / 2, plot.y + 30);
            }
          }
          
          // 绘制花卉生长动画
          this.drawFlowerGrowth(plot);
          break;
          
        case 'ready':
          this.ctx.fillStyle = '#FED7D7'; // 可收获的浅红色
          this.ctx.fillRect(plot.x, plot.y, plot.width, plot.height);
          
          this.ctx.fillStyle = '#E53E3E';
          this.ctx.font = '24px sans-serif';
          this.ctx.textAlign = 'center';
          this.ctx.fillText('可收获', plot.x + plot.width / 2, plot.y + plot.height / 2);
          
          if (plot.flower) {
            const flowerConfig = GameConfig.flowers[plot.flower];
            if (flowerConfig) {
              // 显示花卉图标
              this.ctx.fillStyle = '#D69E2E';
              this.ctx.font = '28px sans-serif';
              this.ctx.fillText('🌻', plot.x + plot.width / 2, plot.y + 30);
            }
          }
          
          // 绘制花卉盛开动画（成熟状态）
          this.drawFlowerGrowth(plot);
          break;
          
        case 'withered':
          this.ctx.fillStyle = '#CBD5E0'; // 枯萎的灰色
          this.ctx.fillRect(plot.x, plot.y, plot.width, plot.height);
          
          this.ctx.fillStyle = '#718096';
          this.ctx.font = '24px sans-serif';
          this.ctx.textAlign = 'center';
          this.ctx.fillText('清理', plot.x + plot.width / 2, plot.y + plot.height / 2);
          break;
      }
      
      // 绘制花田边框
      this.ctx.strokeStyle = '#A0AEC0';
      this.ctx.lineWidth = 2;
      this.ctx.strokeRect(plot.x, plot.y, plot.width, plot.height);
    });
  },
  
  // 渲染底部功能层
  renderBottomBar() {
    const bar = this.bottomBar;
    
    // 绘制背景
    this.ctx.fillStyle = 'rgba(255, 255, 255, 0.95)';
    this.ctx.fillRect(bar.x, bar.y, bar.width, bar.height);
    
    // 绘制顶部边框
    this.ctx.fillStyle = '#E2E8F0';
    this.ctx.fillRect(bar.x, bar.y, bar.width, 2);
    
    // 绘制按钮
    bar.buttons.forEach(button => {
      // 按钮背景
      this.ctx.fillStyle = '#F7FAFC';
      this.ctx.fillRect(button.x, button.y, button.width, button.height);
      
      // 按钮文字
      this.ctx.fillStyle = '#4A5568';
      this.ctx.font = '24px sans-serif';
      this.ctx.textAlign = 'center';
      this.ctx.fillText(button.label, button.x + button.width / 2, button.y + button.height / 2 + 8);
      
      // 按钮图标（简化的emoji）
      this.ctx.font = '32px sans-serif';
      let icon = '';
      switch (button.id) {
        case 'seeds': icon = '🌱'; break;
        case 'collection': icon = '📖'; break;
        case 'decorate': icon = '🎨'; break;
        case 'backpack': icon = '🎒'; break;
        case 'friends': icon = '👥'; break;
      }
      this.ctx.fillText(icon, button.x + button.width / 2, button.y + 35);
    });
  },
  
  // 加载游戏状态
  loadGameState() {
    try {
      const savedState = Platform.getStorage('autoHealingGardenState');
      if (savedState) {
        Object.assign(GameConfig.gameState, savedState);
        console.log('游戏状态加载成功');
        
        // 更新UI显示（确保UI已初始化）
        if (this.topBar) {
          this.topBar.level = GameConfig.gameState.level;
          this.topBar.coins = GameConfig.gameState.coins;
          this.topBar.exp = GameConfig.gameState.exp;
        } else {
          console.warn('UI未初始化，无法更新显示');
        }
      }
    } catch (error) {
      console.error('加载游戏状态异常:', error);
    }
  },
  
  // 保存游戏状态
  saveGameState() {
    try {
      Platform.setStorage('autoHealingGardenState', GameConfig.gameState);
      console.log('游戏状态已保存');
    } catch (error) {
      console.error('保存游戏状态异常:', error);
    }
  },
  
  // 处理触摸事件
  handleTouch(e) {
    const touch = e.touches[0] || e.changedTouches[0];
    if (!touch) return;
    
    const x = touch.clientX;
    const y = touch.clientY;
    
    // 检查是否点击了花田
    for (const plot of this.plots) {
      if (this.isPointInRect(x, y, plot.x, plot.y, plot.width, plot.height)) {
        this.handlePlotClick(plot);
        return;
      }
    }
    
    // 检查是否点击了底部按钮
    for (const button of this.bottomBar.buttons) {
      if (this.isPointInRect(x, y, button.x, button.y, button.width, button.height)) {
        this.handleButtonClick(button);
        return;
      }
    }
  },
  
  // 检查点是否在矩形内
  isPointInRect(x, y, rectX, rectY, rectWidth, rectHeight) {
    return x >= rectX && x <= rectX + rectWidth && y >= rectY && y <= rectY + rectHeight;
  },
  
  // 处理花田点击
  handlePlotClick(plot) {
    if (!plot.isUnlocked) {
      console.log('花田', plot.id, '未解锁');
      // TODO: 显示解锁提示
      return;
    }
    
    switch (plot.state) {
      case 'empty':
        console.log('点击空花田', plot.id, '，打开种子选择');
        this.openSeedSelection(plot);
        break;
      case 'growing':
        console.log('花田', plot.id, '正在生长中，进度:', Math.round(plot.growthProgress * 100), '%');
        break;
      case 'ready':
        console.log('收获花田', plot.id, '的花卉');
        this.harvestPlot(plot);
        break;
      case 'withered':
        console.log('清理枯萎的花田', plot.id);
        this.clearPlot(plot);
        break;
    }
  },
  
  // 打开种子选择
  openSeedSelection(plot) {
    console.log('为花田', plot.id, '选择种子');
    // TODO: 实现种子选择界面
    
    // 临时：直接种植向日葵
    if (this.topBar.coins >= GameConfig.flowers.sunflower.price) {
      this.plantFlower(plot, 'sunflower');
    } else {
      console.log('花币不足，无法种植');
    }
  },
  
  // 种植花卉
  plantFlower(plot, flowerType) {
    const flowerConfig = GameConfig.flowers[flowerType];
    if (!flowerConfig) {
      console.error('未知的花卉类型:', flowerType);
      return;
    }
    
    // 检查是否解锁
    if (flowerConfig.unlockLevel && this.topBar.level < flowerConfig.unlockLevel) {
      console.log('等级不足，需要等级', flowerConfig.unlockLevel);
      return;
    }
    
    // 检查花币是否足够
    if (this.topBar.coins < flowerConfig.price) {
      console.log('花币不足，需要', flowerConfig.price, '当前', this.topBar.coins);
      return;
    }
    
    // 扣除花币
    this.topBar.coins -= flowerConfig.price;
    GameConfig.gameState.coins = this.topBar.coins;
    
    // 种植花卉
    plot.state = 'growing';
    plot.flower = flowerType;
    plot.plantTime = Date.now();
    plot.growthProgress = 0;
    
    console.log('在花田', plot.id, '种植了', flowerConfig.name, '，消耗', flowerConfig.price, '花币');
    
    // 播放种植音效
    this.playPlantSound();
  },
  
  // 收获花田
  harvestPlot(plot) {
    if (plot.state !== 'ready' || !plot.flower) return;
    
    const flowerConfig = GameConfig.flowers[plot.flower];
    if (!flowerConfig) return;
    
    // 获得奖励
    this.topBar.coins += flowerConfig.reward;
    this.topBar.exp += 10; // 每次收获获得10经验
    
    GameConfig.gameState.coins = this.topBar.coins;
    GameConfig.gameState.exp = this.topBar.exp;
    
    // 检查升级
    this.checkLevelUp();
    
    // 重置花田
    plot.state = 'empty';
    plot.flower = null;
    plot.plantTime = 0;
    plot.growthProgress = 0;
    
    console.log('收获', flowerConfig.name, '，获得', flowerConfig.reward, '花币和10经验');
    
    // 播放收获音效
    this.playHarvestSound();
    
    // 显示奖励动画
    this.playHarvestAnimation(plot, flowerConfig.reward);
  },
  
  // 清理花田
  clearPlot(plot) {
    plot.state = 'empty';
    plot.flower = null;
    plot.plantTime = 0;
    plot.growthProgress = 0;
    
    console.log('清理花田', plot.id);
    
    // 播放清理音效
    this.playClearSound();
  },
  
  // 检查升级
  checkLevelUp() {
    const requiredExp = this.topBar.level * 100; // 每级需要等级*100经验
    if (this.topBar.exp >= requiredExp) {
      this.topBar.level++;
      this.topBar.exp -= requiredExp;
      
      GameConfig.gameState.level = this.topBar.level;
      GameConfig.gameState.exp = this.topBar.exp;
      
      console.log('恭喜升级！当前等级：', this.topBar.level);
      
      // 播放升级音效
      this.playLevelUpSound();
      
      // 检查是否解锁新花田
      this.checkUnlockNewPlots();
    }
  },
  
  // 检查是否解锁新花田
  checkUnlockNewPlots() {
    const currentUnlocked = GameConfig.gameState.unlockedPlots;
    const maxPlots = GameConfig.garden.maxPlots;
    
    // 每2级解锁一块新花田
    const newUnlocked = Math.min(maxPlots, Math.floor(this.topBar.level / 2) + 6);
    
    if (newUnlocked > currentUnlocked) {
      GameConfig.gameState.unlockedPlots = newUnlocked;
      
      // 更新花田解锁状态
      for (let i = currentUnlocked; i < newUnlocked && i < this.plots.length; i++) {
        this.plots[i].isUnlocked = true;
      }
      
      console.log('解锁了', newUnlocked - currentUnlocked, '块新花田！');
    }
  },
  
  // 处理按钮点击
  handleButtonClick(button) {
    console.log('点击按钮:', button.id);
    
    switch (button.id) {
      case 'seeds':
        this.openSeedShop();
        break;
      case 'collection':
        this.openCollection();
        break;
      case 'decorate':
        this.openDecoration();
        break;
      case 'backpack':
        this.openBackpack();
        break;
      case 'friends':
        this.openFriends();
        break;
    }
  },
  
  // 打开种子商店
  openSeedShop() {
    console.log('打开种子商店');
    // TODO: 实现种子商店界面
  },
  
  // 打开图鉴
  openCollection() {
    console.log('打开图鉴');
    // TODO: 实现图鉴界面
  },
  
  // 打开装扮
  openDecoration() {
    console.log('打开装扮');
    // TODO: 实现装扮界面
  },
  
  // 打开背包
  openBackpack() {
    console.log('打开背包');
    // TODO: 实现背包界面
  },
  
  // 打开好友
  openFriends() {
    console.log('打开好友');
    // TODO: 实现好友界面
  },
  
  // 播放种植音效
  playPlantSound() {
    // TODO: 使用Platform.createAudio()播放音效
    console.log('播放种植音效');
  },
  
  // 播放收获音效
  playHarvestSound() {
    // TODO: 使用Platform.createAudio()播放音效
    console.log('播放收获音效');
  },
  
  // 播放清理音效
  playClearSound() {
    // TODO: 使用Platform.createAudio()播放音效
    console.log('播放清理音效');
  },
  
  // 播放升级音效
  playLevelUpSound() {
    // TODO: 使用Platform.createAudio()播放音效
    console.log('播放升级音效');
  },
  
  // 显示奖励动画
  showRewardAnimation(plot, amount) {
    console.log('显示奖励动画：+', amount, '花币');
    // TODO: 实现奖励动画
  }
};

// 初始化游戏
AutoHealingGarden.init();

// 绑定触摸事件
if (typeof wx !== 'undefined') {
  wx.onTouchStart(AutoHealingGarden.handleTouch.bind(AutoHealingGarden));
  wx.onTouchEnd(AutoHealingGarden.handleTouch.bind(AutoHealingGarden));
} else if (typeof tt !== 'undefined') {
  tt.onTouchStart(AutoHealingGarden.handleTouch.bind(AutoHealingGarden));
  tt.onTouchEnd(AutoHealingGarden.handleTouch.bind(AutoHealingGarden));
}

// 导出游戏对象
if (typeof module !== 'undefined' && module.exports) {
  module.exports = AutoHealingGarden;
}